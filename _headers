# Cabeceras de seguridad HTTP aplicadas por Netlify a todo el sitio.
# Doc: https://docs.netlify.com/routing/headers/

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# /admin es el panel de Decap CMS — más estricto: no se embebe en
# iframes externos y no se cachea (sesiones/tokens Identity).
/admin/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cache-Control: no-store, no-cache, must-revalidate
